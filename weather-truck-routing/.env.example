# Backend (all optional for local development)
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=*
# Free key from https://openrouteservice.org/dev/#/signup switches routing to the truck (HGV) profile
ORS_API_KEY=
# "mock" = synthetic storm for offline development (flagged in the UI)
WEATHER_PROVIDER=open-meteo
TRUCK_MAX_SPEED_MPH=65

# Frontend (only when the API is hosted on a different origin)
VITE_API_BASE=
